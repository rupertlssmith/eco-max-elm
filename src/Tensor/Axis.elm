{-| One permutation after another: `swap01of3 |> andThen swap12of3` swaps 0 and 1, then 1 and 2.
-}
andThen : Perm t u -> Perm s t -> Perm s u
andThen (I.Perm b) (I.Perm a) =
    I.Perm (a ++ b)


{-| Axis 0 of rank 1, counting from 0, which the operation removes or inserts.
-}
axis0of1 : Axis (R1 a) R0 a
